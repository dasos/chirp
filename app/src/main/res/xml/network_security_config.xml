<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is permitted so the app can reach a self-hosted gateway on the
  local network during development. For non-local hosts the app itself refuses
  plaintext and requires HTTPS — see com.chirp.network.AuthInterceptor.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
