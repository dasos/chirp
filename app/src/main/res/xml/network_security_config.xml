<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is permitted so the app can reach an Ollama server on the local
  network (e.g. http://192.168.x.x:11434) during development. For non-local
  hosts the app itself refuses plaintext and requires HTTPS — see
  com.chirp.network.AuthInterceptor. The reverse proxy (Caddy) terminates TLS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
